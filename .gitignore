.venv/
__pycache__/
*.egg-info/
.pytest_cache/
# raw NHS downloads are large; processed/synthetic data and model outputs are regenerated
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# the aggregated regional table + provenance are tiny and are what the pipeline needs
!data/processed/regional_monthly.csv
!data/processed/release_provenance.csv
outputs/
